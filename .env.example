# ============================================================
# Warehouse Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wms_db
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=change_me_strong_password

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# --- Backend / FastAPI ---
SECRET_KEY=change_me_very_long_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000"]
UPLOADS_DIR=/app/uploads

# --- Frontend / Next.js ---
NEXT_PUBLIC_API_URL=http://localhost/api

# --- First Admin User (created on first startup) ---
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@warehouse.local
FIRST_ADMIN_PASSWORD=change_me_admin_password

